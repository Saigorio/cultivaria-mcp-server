{
  "name": "cultivaria-mcp-server",
  "version": "1.0.0",
  "description": "Servidor MCP (Model Context Protocol) con transporte HTTP/SSE para CultivarIA",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc-watch --onSuccess \"node dist/index.js\"",
    "tunnel": "npx ngrok http 3001"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cultivaria",
    "agronomist-ai",
    "sse"
  ],
  "author": "CultivarIA Team",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.12",
    "localtunnel": "^2.0.2",
    "tsc-watch": "^6.2.0",
    "typescript": "^5.4.5"
  }
}
